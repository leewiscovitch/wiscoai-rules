#!/usr/bin/env bash
# Tests hooks/memory-sync offline: a bare repo in a temp folder and two clones, a and b, stand for two machines.
# Run from anywhere: tests/memory-sync-test. Prints "ok <case>" per case; the first failure prints FAIL and exits 1.
set -eu
here=$(cd "$(dirname "$0")/.." && pwd)
root=$(mktemp -d)
trap 'rm -rf "$root"' EXIT

fail() { echo "FAIL $case: $*"; exit 1; }

# The script always runs from a copy of its own repo, cloned from a local bare one: its pull of "the repo it is in"
# must never reach the network or touch the real clone.
make_rules() { # <folder>
  git init -q --bare -b main "$1.git"
  git clone -q "$1.git" "$1" 2>/dev/null
  mkdir -p "$1/hooks"
  cp "$here/hooks/memory-sync" "$1/hooks/"
  git -C "$1" add hooks
  git -C "$1" -c user.name=t -c user.email=t@t commit -qm script
  git -C "$1" push -q origin main
}
make_rules "$root/rules"
S=$root/rules/hooks/memory-sync

# A fresh remote with a MEMORY.md and one note, cloned into a and b
setup() {
  w=$root/$case
  mkdir -p "$w"
  git init -q --bare -b main "$w/remote.git"
  for c in a b; do
    git clone -q "$w/remote.git" "$w/$c" 2>/dev/null
    git -C "$w/$c" config user.name "$c"
    git -C "$w/$c" config user.email "$c@test"
  done
  printf '# Memory\n- [Note](note.md) - one\n' > "$w/a/MEMORY.md"
  echo 'a note' > "$w/a/note.md"
  git -C "$w/a" add -A
  git -C "$w/a" commit -qm first
  git -C "$w/a" push -q origin main
  git -C "$w/b" pull -q
}

# Runs the script; it must exit 0. Its stdout ends up in $out
run() {
  local rc=0
  out=$("$S" "$@") || rc=$?
  [ "$rc" -eq 0 ] || fail "memory-sync $* exited $rc"
}
quiet() { [ -z "$out" ] || fail "unexpected output: $out"; }
clean() { [ -z "$(git -C "$1" status --porcelain)" ] || fail "$1 is not clean"; }
no_rebase() { [ ! -d "$1/.git/rebase-merge" ] && [ ! -d "$1/.git/rebase-apply" ] || fail "$1 is left in a rebase"; }
on_remote() { git -C "$w/remote.git" cat-file -e "main:$1" 2>/dev/null || fail "$1 is not on the remote"; }

t_travels() {
  echo 'from a' > "$w/a/travel.md"
  run end "$w/a"; quiet
  run start "$w/b"; quiet
  [ "$(cat "$w/b/travel.md")" = 'from a' ] || fail "travel.md did not reach b"
}

t_both_add() {
  echo a > "$w/a/from-a.md"
  echo b > "$w/b/from-b.md"
  run end "$w/a"; quiet
  run end "$w/b"; quiet
  run start "$w/a"; quiet
  run start "$w/b"; quiet
  for c in a b; do
    [ -f "$w/$c/from-a.md" ] && [ -f "$w/$c/from-b.md" ] || fail "$c lacks a file"
  done
}

t_died() {
  echo 'left behind' > "$w/a/left.md"
  run start "$w/a"; quiet
  clean "$w/a"
  on_remote left.md
}

t_conflict() {
  sed -i 's/one/changed in a/' "$w/a/MEMORY.md"
  sed -i 's/one/changed in b/' "$w/b/MEMORY.md"
  run end "$w/a"; quiet
  git -C "$w/b" add -A && git -C "$w/b" commit -qm 'b edits'
  run start "$w/b"
  case $out in "memory-sync: notes out of sync"*) ;; *) fail "no conflict line: '$out'" ;; esac
  [ "$(printf '%s\n' "$out" | wc -l)" -eq 1 ] || fail "more than one line: $out"
  case $out in *"$w/b"*) ;; *) fail "the line does not name the folder: $out" ;; esac
  git -C "$w/b" log --format=%s | grep -qx 'b edits' || fail "b's commit is gone"
  grep -q 'changed in b' "$w/b/MEMORY.md" || fail "b's edit is gone"
  clean "$w/b"; no_rebase "$w/b"
  run end "$w/b"; quiet  # end says nothing, even on the same conflict
  no_rebase "$w/b"
}

t_delete_vs_edit() {
  git -C "$w/a" rm -q note.md
  echo 'edited in b' > "$w/b/note.md"
  run end "$w/a"; quiet
  run start "$w/b"
  case $out in "memory-sync: notes out of sync"*) ;; *) fail "no conflict line: '$out'" ;; esac
  [ "$(cat "$w/b/note.md")" = 'edited in b' ] || fail "b's edited note is gone"
  clean "$w/b"; no_rebase "$w/b"
}

t_mid_rebase() {
  sed -i 's/one/changed in a/' "$w/a/MEMORY.md"
  sed -i 's/one/changed in b/' "$w/b/MEMORY.md"
  run end "$w/a"; quiet
  git -C "$w/b" add -A && git -C "$w/b" commit -qm 'b edits'
  git -C "$w/b" fetch -q
  git -C "$w/b" rebase -q origin/main >/dev/null 2>&1 && fail "the hand-made rebase did not stop"
  [ -d "$w/b/.git/rebase-merge" ] || fail "no rebase in progress to start from"
  run start "$w/b"
  no_rebase "$w/b"
  git -C "$w/b" log --format=%s | grep -qx 'b edits' || fail "b's commit is gone"
}

t_unreachable() {
  git -C "$w/a" remote set-url origin ssh://tech@192.0.2.1/x
  echo 'offline' > "$w/a/offline.md"
  local t0=$SECONDS
  out=$(MEMORY_SYNC_TIMEOUT=2 "$S" start "$w/a") || fail "exit $?"
  [ $((SECONDS - t0)) -lt 6 ] || fail "took $((SECONDS - t0)) s"
  quiet
  clean "$w/a"
  git -C "$w/a" log -1 --name-only --format= | grep -qx offline.md || fail "the note was not committed"
}

t_not_a_repo() {
  mkdir "$w/empty"
  run start "$w/empty"; quiet
  run end "$w/empty"; quiet
  [ -z "$(ls -A "$w/empty")" ] || fail "something was created in the empty folder"
  run start "$w/missing"; quiet
  run end "$w/missing"; quiet
  [ ! -e "$w/missing" ] || fail "the missing folder was created"
  run start; quiet
}

t_locked() {
  echo 'once' > "$w/a/once.md"
  local before rc1=0 rc2=0
  before=$(git -C "$w/a" rev-list --count HEAD)
  "$S" end "$w/a" > "$w/out1" & p1=$!
  "$S" end "$w/a" > "$w/out2" & p2=$!
  wait "$p1" || rc1=$?
  wait "$p2" || rc2=$?
  [ "$rc1" -eq 0 ] && [ "$rc2" -eq 0 ] || fail "exits $rc1 $rc2"
  [ ! -s "$w/out1" ] && [ ! -s "$w/out2" ] || fail "unexpected output"
  [ "$(git -C "$w/a" rev-list --count HEAD)" -eq $((before + 1)) ] || fail "not exactly one commit"
  on_remote once.md
}

t_rules_dirty() {
  local r=$w/rules head
  make_rules "$r"
  # A newer rules commit upstream, then an uncommitted change here: no pull
  git clone -q "$r.git" "$w/upstream" 2>/dev/null
  echo new > "$w/upstream/new.md"
  git -C "$w/upstream" add new.md
  git -C "$w/upstream" -c user.name=t -c user.email=t@t commit -qm new
  git -C "$w/upstream" push -q origin main
  head=$(git -C "$r" rev-parse HEAD)
  echo 'work in progress' >> "$r/hooks/memory-sync"
  out=$("$r/hooks/memory-sync" start "$w/a") || fail "exit $?"
  quiet
  [ "$(git -C "$r" rev-parse HEAD)" = "$head" ] || fail "a dirty rules repo was pulled"
  # Clean again: now it is pulled
  git -C "$r" checkout -q -- hooks/memory-sync
  out=$("$r/hooks/memory-sync" start "$w/a") || fail "exit $?"
  quiet
  [ -f "$r/new.md" ] || fail "a clean rules repo was not pulled"
}

[ -x "$here/hooks/memory-sync" ] || { echo "FAIL: hooks/memory-sync is missing"; exit 1; }
for case in travels both_add died conflict delete_vs_edit mid_rebase unreachable not_a_repo locked rules_dirty; do
  setup
  "t_$case"
  echo "ok $case"
done
